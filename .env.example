# Copy to .env and fill in (or set these in your host's environment settings)
PORT=3000
BASE_URL=https://getabusny.com
NODE_ENV=production

# Where data lives. On a host with a persistent disk, point these at the disk.
# DB_PATH=/data/getabusny.db
# DATA_DIR=/data              # session secret, signed contracts (PDF), signatures
# UPLOAD_DIR=/data/uploads    # fleet photos

# First-run admin login (only used when the database has no users)
ADMIN_EMAIL=you@getabusny.com
ADMIN_PASSWORD=choose-a-long-password

# Stripe, invoice payments. Webhook endpoint: BASE_URL/api/stripe/webhook
# events: checkout.session.completed, charge.refunded
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email, Brevo (same provider as the Everything Shul site). Authenticate your sending domain in Brevo first.
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=Get A Bus NY <quotes@getabusny.com>
# (RESEND_API_KEY works too if you prefer Resend)

# Google Maps, enable "Places API (New)" and "Routes API" on one server key.
# Restrict the key to those two APIs (and to your server's IP if your host gives a fixed one).
GOOGLE_MAPS_API_KEY=AIza...

# FMCSA (SAFER data) for operator checks. Free key from the FMCSA QCMobile developer site. Optional: without it you use the SAFER links by hand.
FMCSA_WEBKEY=

# Chesky, its own Anthropic API key under the business account
CHESKY_API_KEY=sk-ant-...
# CHESKY_MODEL=claude-sonnet-5-5

# Text messages: SimpleSender (same provider as the Kipas Hair BP platform).
# SimpleSender dashboard, Developer, Docs and Keys. Texts go out as POST {SMS_API_BASE}/v1/messages/send.
SMS_API_BASE=
SMS_API_KEY=
# Optional: shared secret if SimpleSender ever supports webhooks (POST /api/public/sms-inbound with header x-webhook-secret)
# SMS_WEBHOOK_SECRET=

# Bus-safe routing and ETAs (HERE Routing API v8, transport mode privateBus). Free tier is plenty.
HERE_API_KEY=

# Optional
# SESSION_SECRET=

# Chesky voice notes: speech to text through OpenAI Whisper (same as JListings). Without it Chesky asks visitors to type.
# OPENAI_API_KEY=
